# DERMAPEX · variables de entorno del frontend (Vite).
# Copiar a .env (no versionado) y sustituir por los valores del proyecto Supabase de DERMAPEX.
# NUNCA incluir aquí ni en Git valores reales, y NUNCA usar la service-role key en el frontend.
VITE_SUPABASE_URL=https://YOUR-DERMAPEX-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_DERMAPEX_SUPABASE_ANON_KEY

# Opcional, solo en build: ruta base de publicación (por defecto '/').
# Ejemplo para GitHub Pages sin dominio propio: DERMAPEX_BASE_PATH=/dermapex/
# DERMAPEX_BASE_PATH=/
